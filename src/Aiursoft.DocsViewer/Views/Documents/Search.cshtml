@using Aiursoft.DocsViewer.Models.DocumentsViewModels
@model Aiursoft.DocsViewer.Models.DocumentsViewModels.SearchViewModel
@{
    <link rel="stylesheet" href="~/styles/markdown-reader.css" asp-append-version="true" />
}

<div class="container-fluid mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 mb-0 text-break mw-100">
            @Localizer["Search"]: <span class="text-primary">@Model.Keyword</span>
        </h1>
        @if (!Model.RateLimited)
        {
            <span class="badge @(Model.UsedAi ? "bg-primary" : "bg-secondary") rounded-pill px-3 py-2">
                @(Model.UsedAi ? Localizer["AI Semantic Search"] : Localizer["Keyword Search"])
            </span>
        }
    </div>

    @if (Model.RateLimited)
    {
        <div class="alert alert-warning" role="alert">
            <div class="alert-message">
                <p>@Localizer["Search is temporarily limited. Please try again in a minute."]</p>
                <a asp-action="Search" asp-route-q="@Model.Keyword" asp-route-page="@Model.Page" class="btn btn-outline-primary">@Localizer["Try again"]</a>
            </div>
        </div>
    }
    else
    {
        <p class="text-muted mb-4">@Localizer["Found {0} documents matching your query.", Model.TotalCount]</p>

        @if (Model.Documents.Count == 0)
        {
            <div class="alert alert-info text-center py-5" role="status">
                <div class="alert-message">
                    @if (Model.TotalCount > 0)
                    {
                        <p>@Localizer["There are no documents on this page."]</p>
                        <a asp-action="Search" asp-route-q="@Model.Keyword" asp-route-page="1" class="btn btn-outline-primary">@Localizer["Back to first page"]</a>
                    }
                    else
                    {
                        <p class="mb-0">@Localizer["No documents matched your search. Try different keywords."]</p>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="row" id="recipes-container">
                @await Html.PartialAsync("_DocumentCards", new DocumentCardsViewModel
                {
                    Documents = Model.Documents,
                    LikeCounts = Model.LikeCounts,
                    LocalizedTitles = Model.LocalizedTitles,
                    LocalizedContents = Model.LocalizedContents
                })
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="@Localizer["Search results pages"].Value" class="mt-4 mb-5">
                    <ul class="pagination flex-wrap justify-content-center mb-0">
                        @if (Model.Page > 1)
                        {
                            <li class="page-item"><a class="page-link" asp-action="Search" asp-route-q="@Model.Keyword" asp-route-page="1">@Localizer["First"]</a></li>
                            <li class="page-item"><a class="page-link" asp-action="Search" asp-route-q="@Model.Keyword" asp-route-page="@(Model.Page - 1)" rel="prev">@Localizer["Previous"]</a></li>
                        }
                        <li class="page-item active"><span class="page-link" aria-current="page">@Localizer["Page {0} of {1}", Model.Page, Model.TotalPages]</span></li>
                        @if (Model.Page < Model.TotalPages)
                        {
                            <li class="page-item"><a class="page-link" asp-action="Search" asp-route-q="@Model.Keyword" asp-route-page="@(Model.Page + 1)" rel="next">@Localizer["Next"]</a></li>
                            <li class="page-item"><a class="page-link" asp-action="Search" asp-route-q="@Model.Keyword" asp-route-page="@Model.TotalPages">@Localizer["Last"]</a></li>
                        }
                    </ul>
                </nav>
            }
        }
    }
</div>
